 impl State {
+    fn queue_smooth_scroll(
+        &mut self,
+        delta: Vector,
+        bounds: Rectangle,
+        content_bounds: Rectangle,
+    ) {
+        let current = self.smooth_target.unwrap_or_else(|| {
+            Vector::new(
+                self.offset_x.absolute(bounds.width, content_bounds.width),
+                self.offset_y.absolute(bounds.height, content_bounds.height),
+            )
+        });
+        self.smooth_target = Some(Vector::new(
+            (current.x + delta.x).clamp(0.0, (content_bounds.width - bounds.width).max(0.0)),
+            (current.y + delta.y).clamp(0.0, (content_bounds.height - bounds.height).max(0.0)),
+        ));
+    }
+
+    fn advance_smooth_scroll(
+        &mut self,
+        bounds: Rectangle,
+        content_bounds: Rectangle,
+    ) -> bool {
+        let Some(target) = self.smooth_target else {
+            return false;
+        };
+        let current = Vector::new(
+            self.offset_x.absolute(bounds.width, content_bounds.width),
+            self.offset_y.absolute(bounds.height, content_bounds.height),
+        );
+        let next = current + (target - current) * 0.28;
+        if (target - current).x.abs() < 0.5 && (target - current).y.abs() < 0.5 {
+            self.offset_x = Offset::Absolute(target.x);
+            self.offset_y = Offset::Absolute(target.y);
+            self.smooth_target = None;
+        } else {
+            self.offset_x = Offset::Absolute(next.x);
+            self.offset_y = Offset::Absolute(next.y);
+        }
+        true
+    }
+
     fn new() -> Self {
         State::default()
     }
